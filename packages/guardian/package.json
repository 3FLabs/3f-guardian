{
  "name": "@3flabs/guardian",
  "version": "0.6.0",
  "description": "HTTP shell for the Guardian off-chain signer service. Hosts plug in policy & signing via a typed abstractions contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "@noble/hashes": "^2.4.0",
    "better-result": "^3.0.1",
    "elysia": "^1.4.30",
    "viem": "^2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@3flabs/guardian-test-fixtures": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3FLabs/3f-guardian.git",
    "directory": "packages/guardian"
  },
  "license": "MIT",
  "sideEffects": false
}
